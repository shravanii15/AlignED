# Secrets - never commit these
.env

# Python
__pycache__/
*.pyc
venv/
.venv/

# Data files (raw pulls can be large / regenerated by scripts)
data/*.json
data/*.csv

# The database file itself is regenerated by setup_database.py,
# so we don't need to store it in GitHub - just the schema.sql blueprint.
database/*.db

# OS junk
.DS_Store
Thumbs.db
