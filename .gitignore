# Secrets - never commit these
.env

# Python
__pycache__/
*.pyc
venv/
.venv/

# Data files (raw pulls can be large / regenerated by scripts)
data/*.json
data/*.csv
data/kaggle_backfill/
data/taxonomy/
data/clustering/
data/gap_analysis/

# Gold-set extraction *run outputs* are regenerated every time the
# pipeline runs, so they're excluded like other raw pulls. The gold-set
# labels themselves (gold_set_combined.json, gold_set_labeled_onet.json)
# and evaluation_results.json are NOT excluded -- they represent real
# hand-labeling work and the key LLM-vs-baseline evidence, so they're
# tracked in Git on purpose.
data/gold_set/baseline_extractions.json
data/gold_set/llm_extractions.json

# The database file WAS originally excluded here on the assumption it'd
# always be rebuilt locally from the scripts. That broke the deployed
# dashboard on Streamlit Cloud, which only has whatever's in GitHub --
# no local Python environment to re-run scraping/extraction/Ollama. So
# the actual populated database is now committed on purpose (see
# database/aligned.db below), and this line is kept only as documentation
# of that decision, not as an active ignore rule.
# database/*.db

# OS junk
.DS_Store
Thumbs.db
