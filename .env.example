# Copy this file to .env and fill in your real keys.
# .env is git-ignored and will never be uploaded to GitHub.
# Variable names below match exactly what each script reads via
# os.getenv() -- see the comment next to each one for which script uses it.

# scripts/fetch_adzuna_jobs.py (daily live job-posting pull)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# scripts/fetch_onet_taxonomy.py (O*NET skills taxonomy download)
# Get a key at https://services.onetcenter.org/ -- O*NET Web Services now
# authenticates with a single API key, not a username/password pair.
ONET_API_KEY=your_onet_api_key_here

# scripts/fetch_kaggle_backfill.py (historical postings backfill, one-time)
# Get a token at https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_API_TOKEN=your_kaggle_api_token_here
